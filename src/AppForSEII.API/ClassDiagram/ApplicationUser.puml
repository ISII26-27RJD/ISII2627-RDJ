@startuml
class ApplicationUser {
    + ApplicationUser()
    + ApplicationUser(id:string, name:string, surname:string, userName:string, dni:string, age:int, sex:string)
    + Name : string <<get>> <<set>>
    + Surname : string <<get>> <<set>>
    + DNI : string <<get>> <<set>>
    + Age : int <<get>> <<set>>
    + Sex : string <<get>> <<set>>
    + Inscripciones : IList<Inscripcion> <<get>> <<set>>
}
@enduml
