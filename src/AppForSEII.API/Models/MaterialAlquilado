using System.ComponentModel.DataAnnotations;

namespace AppForSEII.API.Models
{
    [PrimaryKey(nameof(IdMaterial), nameof(IdAlquiler))]
    public class MaterialAlquilado
    {
        
        public MaterialAlquilado(){}
        
        public int IdMaterial{get; set;}

        public int IdAlquiler{get; set;}

        [Required]
        [Display(Name = "Cantidad")]
        [Range(1,ErrorMessage ="Minimo 1")]
        public int Cantidad{get; set;}
        
        [Required]
        [Display(Name = "Precio")]
        [Range(1,ErrorMessage ="Minimo 1")]
        public decimal Precio{get; set;}

        [Display(Name = "Descripcion")]
        [StringLength(1, ErrorMessage = " ladescripcion debe tener entre 1 y 500 caracteres",MinimumLength = 500)]
        public string Descripcion{get; set;}
        
    }
}
